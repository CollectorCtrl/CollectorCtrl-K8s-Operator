# syntax=docker/dockerfile:1
# Build stage: reproducible build from go.mod/go.sum (no network tidy).
# Base images are pinned by digest; Dependabot keeps tag and digest current.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
# go.mod decides the Go version. When a dependency raises it above the base
# image's Go, fetch the matching toolchain (checksum-verified via sum.golang.org)
# instead of failing; Dependabot bumps the base image separately.
ENV GOTOOLCHAIN=auto
WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/
COPY operator/ operator/
COPY pkg/ pkg/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o manager ./cmd/operator

# Runtime: distroless, non-root, no shell.
FROM gcr.io/distroless/static:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
LABEL org.opencontainers.image.title="CollectorCtrl Kubernetes Operator" \
      org.opencontainers.image.description="Observes OpenTelemetry Collector workloads in Kubernetes and reports them to CollectorCtrl over OpAMP" \
      org.opencontainers.image.source="https://github.com/CollectorCtrl/CollectorCtrl-K8s-Operator" \
      org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /
COPY --from=builder /workspace/manager /manager
USER 65532:65532
# 8080: Prometheus metrics, 8081: health probes
EXPOSE 8080 8081
ENTRYPOINT ["/manager"]
